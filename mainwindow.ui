}
QLCDNumber#temperatureDisplay {
    background: #b7c7d3;
    color: #000000;
    border: 1px solid #000000;
    border-radius: 6px;
}
QPushButton#powerButton {
    background: #d94841;
    color: white;
    border: none;
    border-radius: 40px;
    font-size: 18px;
    font-weight: 600;
    padding: 10px;
}
QPushButton#powerButton:checked {
    background: #168a57;
}
QPushButton#displayModeButton {
    background: #eef3f7;
    color: #253241;
    border: 1px solid #aeb8c2;
    border-radius: 4px;
    padding: 4px 10px;
}
QPushButton#displayModeButton:hover {
    background: #dde8f0;
}
QGroupBox {
    border: 1px solid #ccd5df;
    border-radius: 6px;
    margin-top: 12px;
    padding: 12px 10px 10px 10px;
    color: #283646;
    font-size: 15px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 4px;
}
QRadioButton {
    color: #253241;
    font-size: 15px;
    spacing: 8px;
}</string>
